generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { CUSTOMER ORGANIZER ADMIN }
enum BookingStatus { PENDING CONFIRMED CANCELLED }
model User { id String @id @default(cuid()) email String @unique name String? role Role @default(CUSTOMER) createdAt DateTime @default(now()); events Event[]; bookings Booking[]; flightBookings FlightBooking[]; roadBookings RoadBooking[]; trainBookings TrainBooking[]; shipBookings ShipBooking[]; tourBookings TourBooking[]; itineraries Itinerary[] }
model Event { id String @id @default(cuid()); title String; description String?; category String?; location String?; startsAt DateTime; capacity Int?; price Int @default(0); organizerId String?; organizer User? @relation(fields:[organizerId],references:[id]); bookings Booking[] }
model Booking { id String @id @default(cuid()); userId String; eventId String?; quantity Int @default(1); totalAmount Int @default(0); status BookingStatus @default(PENDING); user User @relation(fields:[userId],references:[id]); event Event? @relation(fields:[eventId],references:[id]); payment Payment?; itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model Payment { id String @id @default(cuid()); bookingId String @unique; provider String; amount Int; currency String @default("KES"); status String; reference String?; booking Booking @relation(fields:[bookingId],references:[id]) }
model TravelAirport { id String @id @default(cuid()); code String @unique; name String; city String; country String @default("KE"); outbound Flight[] @relation("origin"); inbound Flight[] @relation("destination") }
model Flight { id String @id @default(cuid()); flightNo String; airline String; originId String; destinationId String; departure DateTime; arrival DateTime; cabin String @default("Economy"); price Int; seats Int @default(0); origin TravelAirport @relation("origin",fields:[originId],references:[id]); destination TravelAirport @relation("destination",fields:[destinationId],references:[id]); bookings FlightBooking[] }
model FlightBooking { id String @id @default(cuid()); userId String; flightId String; passengers Int @default(1); seat String?; pnr String @unique; qrData String?; user User @relation(fields:[userId],references:[id]); flight Flight @relation(fields:[flightId],references:[id]); itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model BusOperator { id String @id @default(cuid()); name String; phone String?; trips RoadTrip[] }
model RoadRoute { id String @id @default(cuid()); from String; to String; durationMinutes Int; trips RoadTrip[] }
model RoadTrip { id String @id @default(cuid()); routeId String; operatorId String; departure DateTime; vehicleType String; seatLayout String; plate String?; price Int; route RoadRoute @relation(fields:[routeId],references:[id]); operator BusOperator @relation(fields:[operatorId],references:[id]); bookings RoadBooking[] }
model RoadBooking { id String @id @default(cuid()); userId String; tripId String; passengers Int @default(1); seat String?; qrData String?; user User @relation(fields:[userId],references:[id]); trip RoadTrip @relation(fields:[tripId],references:[id]); itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model TrainStation { id String @id @default(cuid()); code String @unique; name String; city String; originRoutes TrainRoute[] @relation("trainOrigin"); destinationRoutes TrainRoute[] @relation("trainDestination") }
model TrainRoute { id String @id @default(cuid()); fromId String; toId String; name String; from TrainStation @relation("trainOrigin",fields:[fromId],references:[id]); to TrainStation @relation("trainDestination",fields:[toId],references:[id]); trips TrainTrip[] }
model TrainTrip { id String @id @default(cuid()); routeId String; departure DateTime; class String; coachCount Int @default(8); price Int; route TrainRoute @relation(fields:[routeId],references:[id]); bookings TrainBooking[] }
model TrainBooking { id String @id @default(cuid()); userId String; tripId String; passengers Int @default(1); coach String?; seat String?; qrData String?; user User @relation(fields:[userId],references:[id]); trip TrainTrip @relation(fields:[tripId],references:[id]); itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model ShipRoute { id String @id @default(cuid()); from String; to String; type String; trips ShipTrip[] }
model ShipTrip { id String @id @default(cuid()); routeId String; departure DateTime; vessel String; cabinTypes String; price Int; route ShipRoute @relation(fields:[routeId],references:[id]); bookings ShipBooking[] }
model ShipBooking { id String @id @default(cuid()); userId String; tripId String; passengers Int @default(1); cabin String?; vehicleCount Int @default(0); qrData String?; user User @relation(fields:[userId],references:[id]); trip ShipTrip @relation(fields:[tripId],references:[id]); itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model Tour { id String @id @default(cuid()); title String; description String?; location String; durationMinutes Int; price Int; guideName String?; included String?; excluded String?; bookings TourBooking[] }
model TourBooking { id String @id @default(cuid()); userId String; tourId String; date DateTime; passengers Int @default(1); user User @relation(fields:[userId],references:[id]); tour Tour @relation(fields:[tourId],references:[id]); itineraryId String?; itinerary Itinerary? @relation(fields:[itineraryId],references:[id]) }
model Itinerary { id String @id @default(cuid()); userId String; title String; createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id]); bookings Booking[]; flights FlightBooking[]; roads RoadBooking[]; trains TrainBooking[]; ships ShipBooking[]; tours TourBooking[] }