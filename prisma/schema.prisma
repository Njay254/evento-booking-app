generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String? role String @default("CUSTOMER") createdAt DateTime @default(now()) bookings Booking[] organizer OrganizerProfile? reviews Review[] }
model Category { id String @id @default(cuid()) name String @unique events Event[] tours Tour[] }
model Event { id String @id @default(cuid()) title String description String? categoryId String? category Category? @relation(fields:[categoryId], references:[id]) location String? latitude Float? longitude Float? startsAt DateTime capacity Int? organizerId String? organizer OrganizerProfile? @relation(fields:[organizerId], references:[id]) tickets Ticket[] bookings Booking[] reviews Review[] }
model Tour { id String @id @default(cuid()) title String description String? categoryId String? category Category? @relation(fields:[categoryId], references:[id]) durationMinutes Int? meetingPoint String? groupSize Int? price Int? organizerId String? organizer OrganizerProfile? @relation(fields:[organizerId], references:[id]) bookings Booking[] reviews Review[] }
model Booking { id String @id @default(cuid()) userId String eventId String? tourId String? quantity Int @default(1) totalAmount Int status String @default("PENDING") createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) event Event? @relation(fields:[eventId], references:[id]) tour Tour? @relation(fields:[tourId], references:[id]) tickets Ticket[] payment Payment? }
model Ticket { id String @id @default(cuid()) bookingId String qrCode String uniqueCode String @unique booking Booking @relation(fields:[bookingId], references:[id]) }
model Review { id String @id @default(cuid()) userId String eventId String? tourId String? rating Int comment String? user User @relation(fields:[userId], references:[id]) event Event? @relation(fields:[eventId], references:[id]) tour Tour? @relation(fields:[tourId], references:[id]) }
model Payment { id String @id @default(cuid()) bookingId String @unique provider String amount Int currency String @default("KES") status String reference String? booking Booking @relation(fields:[bookingId], references:[id]) }
model OrganizerProfile { id String @id @default(cuid()) userId String @unique displayName String bio String? user User @relation(fields:[userId], references:[id]) events Event[] tours Tour[] }